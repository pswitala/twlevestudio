{
  "name": "twelvestudio",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "spike": "tsx server/scripts/spike.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.52.0",
    "multer": "^2.4.0",
    "react": "19.2",
    "react-dom": "19.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}

# Gemini API key from https://aistudio.google.com/apikey (project with billing - Omni/Veo have no free tier)
GEMINI_API_KEY=
# Text model used by the "Enhance" chip
ENHANCE_MODEL=gemini-flash-latest
PORT=5181
# Address both servers listen on: 127.0.0.1 = this machine only, or the LAN IP (e.g. 192.168.255.235).
# There is no login - anyone who can reach it can spend your API credit.
HOST=127.0.0.1
# Omni runs in background mode (survives server restarts) unless this is off.
# It is forced off for "AQ." keys: Google rejects reading their interactions back.
# OMNI_BACKGROUND=off
# OpenRouter key (openrouter.ai/keys) - turns on Seedance, MiniMax H3/Hailuo, HappyHorse, Kling, Wan, Grok Imagine,
# FLUX.3 Video and Runway in the Video model picker, and GPT Image 2.5 / 2, Nano Banana 2.1, Grok Imagine, MAI-Image,
# FLUX.3 Image, Qwen Image, Seedream in the Photo picker. Billed by OpenRouter from your credits.
OPENROUTER_API_KEY=
